{
  "name": "@putong-oj/server",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && cp -r src/scripts dist/scripts",
    "coverage": "c8 report --reporter=text-lcov > coverage.lcov",
    "dev": "cross-env NODE_ENV=development node --watch src/main.ts",
    "posttest": "cross-env NODE_ENV=test node test/seed.ts --clean",
    "pretest": "cross-env NODE_ENV=test node test/seed.ts",
    "report": "c8 report --reporter=html",
    "start": "cross-env NODE_ENV=production node dist/main.js",
    "test": "cross-env NODE_ENV=test c8 ava",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.test.json"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@noble/ciphers": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@putong-oj/db": "workspace:*",
    "@putong-oj/shared": "workspace:*",
    "@zip.js/zip.js": "catalog:",
    "co-body": "catalog:",
    "cross-env": "catalog:",
    "dotenv-flow": "catalog:",
    "formidable": "catalog:",
    "fs-extra": "catalog:",
    "ioredis": "catalog:",
    "lodash": "catalog:",
    "luxon": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/co-body": "catalog:",
    "@types/formidable": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@types/ws": "catalog:",
    "ava": "catalog:",
    "c8": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:"
  },
  "ava": {
    "concurrency": 1,
    "environmentVariables": {
      "NODE_ENV": "test"
    },
    "extensions": [
      "ts",
      "js"
    ],
    "files": [
      "test/**/*.e2e-spec.ts",
      "test/**/*.spec.ts"
    ],
    "require": [
      "./test/_force-exit.mjs"
    ],
    "serial": true,
    "timeout": "30s"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ]
  }
}
